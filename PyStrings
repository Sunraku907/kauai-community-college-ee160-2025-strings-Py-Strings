# Step 2: Count how many times the letter 'e' takes place
e_count = text.count('e')
print(f"\nThe letter 'e' has showed up {e_count} times")

# Step 3: Count how many times the letter 'b' shows up
b_count = text.count('b')
print(f"\nThe letter b has shown up {b_count} times")

# Step 4: Print the first 20 characters after the first 'e'
