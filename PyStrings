    print(text[first_e + i], end='')



# Step 5: Count how many words are in the text
words = text.split()
word_count = len(words)
print(f"\n\nTotal words: {word_count}")

# Step 6: Count how many sentences are in the text
sentences = re.split(r'[.!?]', text)
sentences = [s.strip() for s in sentences if s.strip()]
sentence_count = len(sentences)
print(f"\nTotal sentences: {sentence_count}")

# Step 7: Find the shortest sentence
shortest_sentence = min(sentences, key=len)
print(f"\nThe shortest sentence is: \n{shortest_sentence}")

# Step 8: Count how many unique words are in the text
text = text.lower()
punctuation = ".?!,;:\"'()[]{}"
for char in punctuation:
    text = text.replace(char, "")
    unique_words = set(words)
print(f"\nThere are {len(unique_words)} unique words in the text")

